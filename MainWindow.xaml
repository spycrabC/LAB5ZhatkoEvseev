<Window x:Class="LAB5ZhatkoEvseev.MainWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
        Title="Авторизация" Height="430" Width="303">
    <StackPanel>
        <TextBlock Text="Авторизация" FontSize="30" TextAlignment="Center" Margin="10,20,10,40" />

        <TextBlock Text="Логин" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="TbLogin" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <TextBlock Text="Пароль" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="TbPassword" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center" Margin="0,0,0,40"/>

        <Button x:Name="btnLogin" Content="Вход" FontSize="20" Margin="30,10,30,0" Click="btnLogin_Click"/>

    </StackPanel>
</Window>
