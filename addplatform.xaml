<Window x:Class="LAB5ZhatkoEvseev.addplatform"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
        Title="addplatform" Height="566" Width="406">
    <StackPanel>
        <TextBlock Text="Добавление площадки" FontSize="30" TextAlignment="Center" Margin="10,20,10,40" />

        <TextBlock Text="Адрес" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbAdres" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <TextBlock Text="Сумма аренды" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbsumarendi" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center" />

        <TextBlock Text="Вместимость" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbVmestimost" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center" />

        <TextBlock Text="Тип площадки" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <ComboBox x:Name="cbType" DisplayMemberPath="Name" SelectedValuePath="PkTypeplatform" Width="216"/>

        <Button Content="Добавить площадку" FontSize="20" Margin="30,10,30,0" Click="Button_Click"/>
        <Button x:Name="exit" Content="Вернуться назад" FontSize="20" Margin="30,10,30,0" Click="exit_Click"/>


    </StackPanel>
</Window>
