<Window x:Class="LAB5ZhatkoEvseev.RedaktEmploy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
        Title="RedaktEmploy" Height="986" Width="430">
    <StackPanel>
        <TextBlock Text="Редактирование сотрудника" FontSize="30" TextAlignment="Center" Margin="10,20,10,40" />

        <TextBlock Text="Логин" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbLogin" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <TextBlock Text="Пароль" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbPassword" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center" />

        <TextBlock Text="Фамилия" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbSurname" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center" />

        <TextBlock Text="Имя" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbSName" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <TextBlock Text="Отчество" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbPatronymic" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <TextBlock Text="Телефон" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbPhone" MaxLength="11" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center" Margin="0,0,0,40"/>
        
        <TextBlock Text="Должность" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <ComboBox x:Name="cbJob" DisplayMemberPath="NameJob" SelectedValuePath="NameJob" Width="216"/>
        
        <TextBlock Text="Ставка" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbBid" MaxLength="11" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <Button Content="Изменить" FontSize="20" Margin="30,10,30,0" Click="Button_Click"/>
        <Button x:Name="exit" Content="Вернуться назад" FontSize="20" Margin="30,10,30,0" Click="exit_Click"/>


    </StackPanel>
</Window>
