<Window x:Class="LAB5ZhatkoEvseev.redactGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
           Title="addGroup" Height="566" Width="406">
    <Grid>
        <StackPanel>
            <TextBlock Text="Редактирование группы" FontSize="30" TextAlignment="Center" Margin="10,20,10,40" />

            <TextBlock Text="Проект" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <ComboBox x:Name="cbProjects" DisplayMemberPath="NameProject" Width="216" SelectionChanged="cbProjects_SelectionChanged"/>

            <TextBlock Text="Сотрудник" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <ComboBox x:Name="cbСотрудники" DisplayMemberPath="Name" Width="216" SelectionChanged="cbСотрудники_SelectionChanged"/>

            <Button Content="Редактировать группу" FontSize="20" Margin="30,10,30,0" Click="Button_Click"/>
            <Button x:Name="exit" Content="Вернуться назад" FontSize="20" Margin="30,10,30,0" Click="exit_Click"/>


        </StackPanel>
    </Grid>
</Window>
