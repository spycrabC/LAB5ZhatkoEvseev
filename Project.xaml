<Window x:Class="LAB5ZhatkoEvseev.Project"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
        Title="Project" Height="450" Width="800">
    <Grid Margin="0,93,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="349*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="dgProject" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*"  Header="Имя" Binding="{Binding NameProject}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="Тип" Binding="{Binding FkTypeProjectNavigation.NameType}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="жанр" Binding="{Binding FkGenreProjectNavigation.NameGenre}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="дата старта" Binding="{Binding DateStart}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="дата старта" Binding="{Binding DateEnd}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="Статус" Binding="{Binding FkStatusProjectNavigation.NameProject}">
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>
        <Button Content="Добавить" HorizontalAlignment="Left" Margin="29,-57,0,0" VerticalAlignment="Top" Width="141" Click="Button_Click"/>
        <Button x:Name="Btn_del" Content="Удалить" HorizontalAlignment="Left" Margin="352,-57,0,0" VerticalAlignment="Top" Width="141" RenderTransformOrigin="0.579,0.671" Click="Btn_del_Click"/>
        <TextBox x:Name="tbSearchProject" HorizontalAlignment="Left" Margin="519,-55,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="94" TextChanged="TextBox_TextChanged"/>
        <Button x:Name="Btn_Red" Content="Редактировать" HorizontalAlignment="Left" Margin="192,-57,0,0" VerticalAlignment="Top" Width="139" Click="Btn_Red_Click"/>
        <Button Content="QR-Code" HorizontalAlignment="Left" Margin="651,-90,0,0" VerticalAlignment="Top" Width="118" Click="Button_Click_1" Grid.ColumnSpan="2"/>
        <Button Content="Excel" HorizontalAlignment="Left" Margin="651,-47,0,0" VerticalAlignment="Top" Width="118" Click="Button_Click_2" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
