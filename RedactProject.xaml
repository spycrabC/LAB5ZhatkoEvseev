<Window x:Class="LAB5ZhatkoEvseev.RedactProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
        Title="RedactProject" Height="986" Width="430">
    <Grid>
        <StackPanel>
            <TextBlock Text="Редактирование проекта" FontSize="30" TextAlignment="Center" Margin="10,20,10,40" />

            <TextBlock Text="Название проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <TextBox x:Name="tbNameProject" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

            <TextBlock Text="Жанр проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <ComboBox x:Name="cbTypeGenre" DisplayMemberPath="FkGenreProjectNavigation.NameGenre" Width="216"/>

            <TextBlock Text="Тип проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <ComboBox x:Name="cbTypeProject" DisplayMemberPath="FkTypeProjectNavigation.NameType" Width="216"/>

            <TextBlock Text="Статус проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <ComboBox x:Name="cbStatusProject" DisplayMemberPath="FkStatusProjectNavigation.NameProject" Width="216"/>

            <TextBlock Text="Дата начала" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <DatePicker x:Name="dpDateStart" Text="DateStart" Margin="10,20,10,10" Width="216" />

            <TextBlock Text="Дата конца" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <DatePicker x:Name="dpDateEnd" Text="DateEnd" Margin="10,20,10,10" Width="216" />


            <TextBlock Text="Возрастной рейтинг" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
            <TextBox x:Name="tbAgeRating" MaxLength="11" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

            <Button Content="Изменить" FontSize="20" Margin="30,10,30,0" Click="Button_Click"/>
            <Button x:Name="exit" Content="Вернуться назад" FontSize="20" Margin="30,10,30,0" Click="exit_Click"/>


        </StackPanel>
        
    </Grid>
</Window>
