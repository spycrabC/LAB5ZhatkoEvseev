<Window x:Class="LAB5ZhatkoEvseev.Graphic"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
         Title="График съемок" Height="450" Width="800">
    <Grid Margin="0,93,0,0">
        <DataGrid x:Name="dgsemachnaaGroup" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*"  Header="Дата" Binding="{Binding FkTabnomerNavigation.Name}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="Время" Binding="{Binding FkProjectNavigation.ProjectName}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="Проект" Binding="{Binding FkProjectNavigation.ProjectName}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="Площадка" Binding="{Binding FkProjectNavigation.ProjectName}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="Сцена" Binding="{Binding FkProjectNavigation.ProjectName}">
                </DataGridTextColumn>
                <DataGridTextColumn Width="*"  Header="описание" Binding="{Binding FkProjectNavigation.ProjectName}">
                </DataGridTextColumn>

            </DataGrid.Columns>

        </DataGrid>
        <Button Content="Добавить" HorizontalAlignment="Left" Margin="29,-57,0,0" VerticalAlignment="Top" Width="141" Click="Button_Click"/>
        <Button x:Name="Btn_del" Content="Удалить" HorizontalAlignment="Left" Margin="352,-57,0,0" VerticalAlignment="Top" Width="141" RenderTransformOrigin="0.579,0.671" Click="Btn_del_Click"/>
        <TextBox x:Name="tbSearch" HorizontalAlignment="Left" Margin="519,-55,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="197" TextChanged="TextBox_TextChanged"/>
        <Button x:Name="Btn_Red" Content="Редактировать" HorizontalAlignment="Left" Margin="192,-57,0,0" VerticalAlignment="Top" Width="139" Click="Btn_Red_Click"/>

    </Grid>
</Window>
