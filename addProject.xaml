<Window x:Class="LAB5ZhatkoEvseev.addProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5ZhatkoEvseev"
        mc:Ignorable="d"
        Title="addProject" Height="712" Width="326">
    <StackPanel>
        <TextBlock Text="Новый проект" FontSize="30" TextAlignment="Center" Margin="10,20,10,40" />

        <TextBlock Text="Название проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <TextBox x:Name="tbSName" TextWrapping="Wrap" Width="220" Height="30" TextAlignment="Center"/>

        <TextBlock Text="Жанр проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <ComboBox x:Name="cbGenre" DisplayMemberPath="NameGenre" Width="216"/>
        
        <TextBlock Text="Тип проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <ComboBox x:Name="cbType" DisplayMemberPath="NameType" Width="216"/>
        
        <TextBlock Text="Статус проекта" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <ComboBox x:Name="cbStatus" DisplayMemberPath="NameProject" Width="216"/>

        <TextBlock Text="Дата начала" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <DatePicker x:Name="dpStart" SelectedDateFormat="Short" Height="25" Width="200"/>

        <TextBlock Text="Дата конца" FontSize="20" TextAlignment="Center" Margin="10,20,10,10" />
        <DatePicker x:Name="dpEnd" SelectedDateFormat="Short" Height="25" Width="200"/>


        <Button Content="Добавить проект" FontSize="20" Margin="30,10,30,0" Click="Button_Click"/>
        <Button x:Name="exit" Content="Вернуться назад" FontSize="20" Margin="30,10,30,0" Click="exit_Click"/>
        


    </StackPanel>
</Window>
